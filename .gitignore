# ==========================================
# HireWise - Root Git Ignore File
# ==========================================

# ------------------------------------------
# Environment & Secret Variables (CRITICAL)
# ------------------------------------------
.env
.env.*
*.env
*.env.local
backend/.env
frontend/.env.local
frontend/.env*.local

# Allow example config templates to be committed
!.env.example
!backend/.env.example
!frontend/.env.local.example
!frontend/.env.example

# ------------------------------------------
# Node.js & Next.js Frontend
# ------------------------------------------
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
dist/
frontend/dist/
.turbo/
*.tsbuildinfo
frontend/*.tsbuildinfo

# Node package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Python Backend
# ------------------------------------------
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
backend/venv/
backend/.venv/

# Python test, coverage and build
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------
# Database & Uploads
# ------------------------------------------
*.sqlite
*.sqlite3
*.db
uploads/
backend/uploads/
*.pdf
!backend/tests/*.pdf

# ------------------------------------------
# Logs & Temporary Files
# ------------------------------------------
*.log
logs/
backend/logs/
*.tmp
*.bak
*.swp
*.swo

# ------------------------------------------
# IDE & Operating System
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# AI Agent & Internal Scratch Dirs
.gemini/
.antigravity/
brain/
