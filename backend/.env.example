# HireWise Backend Environment Configuration

# Google Gemini API Key
GEMINI_API_KEY=your_google_gemini_api_key_here

# PostgreSQL + pgvector Database URL (Neon DB or local PostgreSQL)
DATABASE_URL=postgresql://username:password@ep-host.region.aws.neon.tech/neondb?sslmode=require

# Model Configuration
LLM_MODEL=gemini-2.0-flash
FALLBACK_LLM_MODELS=gemini-3.8-flash,gemini-flash-latest,gemini-1.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SMTP Email Delivery for Password Recovery (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_here
SMTP_FROM=your_email@gmail.com
SMTP_USE_TLS=true
